# Lesson request delivery. Configure at least one channel in production,
# otherwise the form tells visitors to call instead of silently dropping requests.

# Email via Resend (https://resend.com). Verify the sending domain in Resend first.
RESEND_API_KEY=
# Where requests go. Comma-separate multiple addresses.
LESSON_TO_EMAIL=
# Sender shown on the email. Must be on a domain verified in Resend.
LESSON_FROM_EMAIL="Pinnacle Website <lessons@pinnacle-baseball.com>"

# Optional: also POST each request as JSON (n8n, Zapier, Make, a Google Sheet script...).
LEAD_WEBHOOK_URL=
